{
  "name": "sonic-archive",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "paths": "node apps/server/src/cli.ts paths",
    "db:migrate": "node apps/server/src/cli.ts migrate",
    "scan": "node apps/server/src/cli.ts scan",
    "analyze": "node apps/server/src/cli.ts analyze",
    "fixtures:generate": "./test-fixtures/generate.sh",
    "dev:server": "node --watch apps/server/src/main.ts",
    "dev": "pnpm --parallel --filter @sonic-archive/server --filter @sonic-archive/web dev",
    "build": "pnpm --filter @sonic-archive/web build",
    "start": "pnpm build && SONIC_WEB_DIST=apps/web/dist node apps/server/src/main.ts",
    "start:watch": "pnpm start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
